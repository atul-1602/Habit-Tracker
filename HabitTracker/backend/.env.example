# =============================================================
# HABIT TRACKER – Backend Environment Variables
# Copy this file: cp .env.example .env
# =============================================================

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
# Format:   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=YOUR_MONGODB_URI
PORT=5000
NODE_ENV=development

# ── Auth (required) ───────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys → Secret key
# Used to verify session tokens the app sends — never expose this value to clients.
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins for browser/web clients in production.
# Leave empty if only the native app calls this API.
CORS_ORIGIN=
